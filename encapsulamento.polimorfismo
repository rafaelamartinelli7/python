# Exemplo Encapsulamento 
class Conta:
    def __init__(self, saldo):
        self.__saldo = saldo

    def consultar_saldo(self):
        return self.__saldo

    def depositar(self, valor):
        if valor > 0:
            self.__saldo += valor

conta = Conta(100)
conta.depositar(50)
print(conta.consultar_saldo())


# Exemplo Polimorfismo 
class Cachorro:
    def emitir_som(self):
        print("Au au!")

class Gato:
    def emitir_som(self):
        print("Miau!")

animais = [Cachorro(), Gato()]

for animal in animais:
    animal.emitir_som()


